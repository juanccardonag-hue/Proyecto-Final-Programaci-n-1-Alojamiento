<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="co.edu.uniquindio.view.UI">
  <grid id="27dc6" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="960" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="d1a1f" binding="mainPanel" layout-manager="GridLayoutManager" row-count="2" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <background color="-1"/>
          <font name="Vensim Sans Mono" size="14" style="1"/>
          <foreground color="-2507057"/>
        </properties>
        <border type="none" title="">
          <title-color color="-3025959"/>
        </border>
        <children>
          <component id="7f3df" class="javax.swing.JLabel" binding="welcomeTittle">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="0" anchor="0" fill="2" indent="0" use-parent-layout="false">
                <preferred-size width="948" height="190"/>
              </grid>
            </constraints>
            <properties>
              <font name=".AppleSystemUIFont" size="20" style="1"/>
              <foreground color="-16746570"/>
              <text value="Bienvenido/a! Este es el sistema de gestión de alojamientos de Aparta-Suites UQ"/>
            </properties>
          </component>
          <component id="ef394" class="javax.swing.JButton" binding="adminBtn">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-1"/>
              <borderPainted value="true"/>
              <font name="Vensim Sans Mono" size="16" style="0"/>
              <foreground color="-16746570"/>
              <margin top="10" left="20" bottom="10" right="20"/>
              <text value="Soy administrador"/>
            </properties>
          </component>
          <component id="48aa8" class="javax.swing.JButton" binding="huespedBtn">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Vensim Sans Mono" size="16" style="0"/>
              <foreground color="-16746570"/>
              <margin top="10" left="20" bottom="10" right="20"/>
              <text value="Soy huesped"/>
            </properties>
          </component>
          <component id="13b17" class="javax.swing.JButton" binding="recepcionistaBtn">
            <constraints>
              <grid row="1" column="2" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Vensim Sans Mono" size="16" style="0"/>
              <foreground color="-16746570"/>
              <margin top="10" left="20" bottom="10" right="20"/>
              <text value="Soy recepcionista"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
