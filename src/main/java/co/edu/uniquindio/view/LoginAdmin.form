<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="co.edu.uniquindio.view.LoginAdmin">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="bd0e" binding="loginPanel" layout-manager="GridLayoutManager" row-count="6" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="b973c" class="javax.swing.JTextField" binding="inputUsuario">
            <constraints>
              <grid row="2" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="200" height="35"/>
              </grid>
            </constraints>
            <properties>
              <text value=""/>
            </properties>
          </component>
          <component id="15210" class="javax.swing.JPasswordField" binding="inputPassword">
            <constraints>
              <grid row="4" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="250" height="35"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="d4b28" class="javax.swing.JLabel" binding="tittleLogin">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Vensim Sans Mono" size="16" style="1"/>
              <foreground color="-3781447"/>
              <text value="Inicar sesión como administrador"/>
            </properties>
          </component>
          <component id="8b92" class="javax.swing.JLabel" binding="txtUsuario">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Vensim Sans Mono" size="14" style="0"/>
              <text value="Ingresa tu usuario:"/>
            </properties>
          </component>
          <component id="cc628" class="javax.swing.JLabel" binding="txtContrasena">
            <constraints>
              <grid row="3" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Vensim Sans Mono" size="14" style="0"/>
              <text value="Ingresa tu contraseña:"/>
            </properties>
          </component>
          <component id="7deba" class="javax.swing.JButton" binding="btnIngreso">
            <constraints>
              <grid row="5" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="35"/>
              </grid>
            </constraints>
            <properties>
              <focusable value="false"/>
              <font name="Vensim Sans Mono" size="14" style="0"/>
              <text value="Ingresar"/>
            </properties>
          </component>
          <component id="6d90b" class="javax.swing.JButton" binding="cancelarBtn">
            <constraints>
              <grid row="5" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="35"/>
              </grid>
            </constraints>
            <properties>
              <font name="Vensim Sans Mono" size="14" style="0"/>
              <text value="Cancelar"/>
            </properties>
          </component>
          <hspacer id="7ec35">
            <constraints>
              <grid row="2" column="3" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
